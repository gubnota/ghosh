{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghosh",
  "version": "0.1.3",
  "identifier": "app.ghosh.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ghosh",
        "width": 1160,
        "height": 780,
        "minWidth": 820,
        "minHeight": 600,
        "backgroundColor": "#011627"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "ghosh"
        ],
        "name": "Ghosh workspace",
        "role": "Editor",
        "contentTypes": [
          "app.ghosh.workspace"
        ]
      }
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
